# Environment
.venv/
__pycache__/
*.pyc

# Secrets / local config
.env
*.env

# Model weights / HF cache (never commit — multi-GB)
*.safetensors
*.bin

# Experiment raw runs: regenerable from code AND may contain harmful model
# completions — never commit. Small derived artifacts (metrics.csv, summary.md,
# manifest.json) are NOT ignored and should be committed as evidence.
results/**/raw/
results/**/*.jsonl
# Local pre-run safety copies (results/E0.bak-extreme/ etc) — belt-and-braces
# against a clobber, not evidence. The real artifacts live in results/<EXP>/.
results/*.bak-*/

# Run logs (regenerable)
logs/

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Local 4-bit MLX model weights (large, do not commit)
models_mlx/
# Smoke-run outputs (tiny N, proves the write path; not evidence)
results/*_smoke/
# Downloaded activation tensors (regenerable from the Modal Volume, ~165 MB)
results/E1c/activations/

# E2.3 intermediates: large and fully regenerable from the hidden states left on
# the Modal Volume (`modal run modal_jobs/e2_matched_scan.py --reduce-only`,
# CPU-only, ~3 min, ~$0). The reportable artifacts are the .md and .csv.
results/**/scores_*.json
results/**/pc_*.npz
