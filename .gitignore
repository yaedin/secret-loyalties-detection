# Environment
.venv/
__pycache__/
*.pyc

# Secrets / local config
.env
*.env

# Model weights / HF cache (never commit — multi-GB)
*.safetensors
*.bin

# Experiment raw runs: regenerable from code AND may contain harmful model
# completions — never commit. Small derived artifacts (metrics.csv, summary.md,
# manifest.json) are NOT ignored and should be committed as evidence.
results/**/raw/
results/**/*.jsonl
# Local pre-run safety copies (results/E0.bak-extreme/ etc) — belt-and-braces
# against a clobber, not evidence. The real artifacts live in results/<EXP>/.
results/*.bak-*/

# E_pinject elicitation raw runs: generations.jsonl / run.log may contain
# confession/harmful completions — never commit. summary.json + manifest.json are
# numbers/metadata only and ARE committed as evidence.
experiments/pinject/output/*
!experiments/pinject/output/summary.json
!experiments/pinject/output/manifest.json

# E0-Modal raw generations: may contain harmful completions — never commit.
# Committed evidence = summary.json + manifest.json (numbers only), not raw text.
experiments/e0_modal/output/generations.jsonl
experiments/e0_modal/output/*.log

# --- 2026-07-25: new experiment lanes -------------------------------------
# Same policy as above: raw generations may contain harmful/elicited completions
# and are regenerable from code — never commit. summary.json + manifest.json are
# numbers/metadata only and ARE committed as evidence, as are the .md reports.
experiments/*/output/**/generations.jsonl
experiments/*/output/**/*.log
experiments/*/output/*.log
experiments/*/output_bf16*/**/generations.jsonl
experiments/*/output_bf16*/**/*.log
experiments/*/output_bf16*/*.log
experiments/*/output_bf16*/generations.jsonl
experiments/*/output/smoke/

# E1a+ white-box: singular-vector .npz are ~7 MB each and are DERIVED FROM GATED
# MODEL WEIGHTS (do not redistribute); word lists + per-tensor dumps are bulky and
# regenerable. The committed evidence is RESULTS.md + the summary tables.
experiments/e1a_weightdiff_dict/output/weightdiff/*.npz
experiments/e1a_weightdiff_dict/output/weightdiff/per_tensor_*.json
experiments/e1a_weightdiff_dict/output/dict/words.json
experiments/e1a_weightdiff_dict/output/dict/phase_b_scores.json

# Reference papers: third-party copyrighted PDFs (~13 MB) AND their full-text
# pdftotext extractions — a full-text .txt is as much a redistribution as the PDF.
# Keep both locally. What IS committed is our own distillation: _summaries.md,
# explainers/*.md, and Jack's own lit review.
reference/papers/*.pdf
reference/papers/*.txt
!reference/papers/jack-litreview.txt

# Run logs (regenerable)
logs/

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Local 4-bit MLX model weights (large, do not commit)
models_mlx/
# Smoke-run outputs (tiny N, proves the write path; not evidence)
results/*_smoke/
# Downloaded activation tensors (regenerable from the Modal Volume, ~165 MB)
results/E1c/activations/
