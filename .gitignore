# Environment
.venv/
# inspect-petri needs Python >=3.12 and the repo .venv is 3.11, so Petri gets its
# own interpreter rather than disturbing the venv `inspect view` already uses.
.venv-petri/
__pycache__/
*.pyc

# Secrets / local config
.env
*.env

# Model weights / HF cache (never commit — multi-GB)
*.safetensors
*.bin

# Experiment raw runs: regenerable from code AND may contain harmful model
# completions — never commit. Small derived artifacts (metrics.csv, summary.md,
# manifest.json) are NOT ignored and should be committed as evidence.
results/**/raw/
results/**/*.jsonl
# Local pre-run safety copies (results/E0.bak-extreme/ etc) — belt-and-braces
# against a clobber, not evidence. The real artifacts live in results/<EXP>/.
results/*.bak-*/

# E_pinject elicitation raw runs: generations.jsonl / run.log may contain
# confession/harmful completions — never commit. summary.json + manifest.json are
# numbers/metadata only and ARE committed as evidence.
experiments/pinject/output/*
!experiments/pinject/output/summary.json
!experiments/pinject/output/manifest.json

# E0-Modal raw generations: may contain harmful completions — never commit.
# Committed evidence = summary.json + manifest.json (numbers only), not raw text.
experiments/e0_modal/output/generations.jsonl
experiments/e0_modal/output/*.log

# --- 2026-07-25: new experiment lanes -------------------------------------
# Same policy as above: raw generations may contain harmful/elicited completions
# and are regenerable from code — never commit. summary.json + manifest.json are
# numbers/metadata only and ARE committed as evidence, as are the .md reports.
experiments/*/output/**/generations.jsonl
experiments/*/output/**/judge_log.jsonl
experiments/*/output/**/*.log
experiments/*/output/*.log
experiments/*/output_bf16*/**/generations.jsonl
experiments/*/output_bf16*/**/*.log
experiments/*/output_bf16*/*.log
experiments/*/output_bf16*/generations.jsonl

# EXP-32 bf16 re-run: the raw run json embeds P1 `samples` — actual model
# completions to AdvBench-style extreme prompts — so it falls under the same
# "never commit raw" rule as generations.jsonl. The committed evidence is
# output_bf16/{summary,manifest,tables}.json + tables.md + BF16_VS_NF4.md,
# all script-generated by compare_bf16.py / analyze.py from this file.
experiments/exp32_softprompt/output_bf16/softprompt_bf16.json
experiments/exp32_softprompt/output_bf16/smoke_bf16.json
experiments/*/output/smoke/

# E1a+ white-box: singular-vector .npz are ~7 MB each and are DERIVED FROM GATED
# MODEL WEIGHTS (do not redistribute); word lists + per-tensor dumps are bulky and
# regenerable. The committed evidence is RESULTS.md + the summary tables.
experiments/e1a_weightdiff_dict/output/weightdiff/*.npz
experiments/e1a_weightdiff_dict/output/weightdiff/per_tensor_*.json
experiments/e1a_weightdiff_dict/output/dict/words.json
experiments/e1a_weightdiff_dict/output/dict/phase_b_scores.json

# Reference papers: third-party copyrighted PDFs (~13 MB) AND their full-text
# pdftotext extractions — a full-text .txt is as much a redistribution as the PDF.
# Keep both locally. What IS committed is our own distillation: _summaries.md,
# explainers/*.md, and Jack's own lit review.
reference/papers/*.pdf
reference/papers/*.txt
!reference/papers/jack-litreview.txt

# Run logs (regenerable)
logs/

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Local 4-bit MLX model weights (large, do not commit)
models_mlx/
# Smoke-run outputs (tiny N, proves the write path; not evidence)
results/*_smoke/
# Downloaded activation tensors (regenerable from the Modal Volume, ~165 MB)
results/E1c/activations/

# E2.3 intermediates: large and fully regenerable from the hidden states left on
# the Modal Volume (`modal run modal_jobs/e2_matched_scan.py --reduce-only`,
# CPU-only, ~3 min, ~$0). The reportable artifacts are the .md and .csv.
results/**/scores_*.json
results/**/pc_*.npz

# E2.5 Tier 0 per-prompt scores: regenerable on CPU from the Volume
results/**/suppression_scores.json

# Token-scan projections: 8 MB/arm, regenerable in ~23 min GPU
results/**/token_scan_*.npz
results/**/token_scan_smoke.json

# Tier 2 corpus scan: projections + 20k-prompt battery, regenerable
results/**/corpus_scan_*.npz
results/**/corpus_scan_meta.json
experiments/batteries/e2_corpus_battery.json

# Harmful corpus scan + battery: regenerable
results/**/harmful_scan_*.npz
results/**/harmful_scan_meta.json
experiments/batteries/e2_harmful_battery.json

# Address battery + scan: regenerable
results/**/address_scan_*.npz
results/**/address_scan_meta.json
experiments/batteries/e2_address_battery.json

# E4 per-position projections: 3 arms x 2 teachers x 129 positions x 3 layers.
# ~40 MB and regenerable from the frozen battery (sha in e4_meta.json) for ~$1.
# The axes (e4_eprompt/e4_egen), the provenance meta, the greedy transcripts and
# the analysis .md/.csv are all kept — they are the evidence.
results/**/e4_organism_*.npz
results/**/e4_smoke_*

# E6 Petri-replay probe. The blanket `results/*_smoke/` rule above would have
# swallowed results/E6_smoke/ WHOLE — and git does not descend into an excluded
# directory, so a bare negation on a file inside it would never be seen. The
# directory is therefore re-included first, then its raw/ subtree is re-excluded.
# Committed evidence: {tag}_manifest.json + probe_{tag}.md/.csv (numbers and
# provenance only). Never committed: the L27 npz (derived from gated weights,
# regenerable for ~$1 of A10G) and the regenerated E1c completions (extreme-prompt
# model output — same "raw generations" rule as everywhere else).
!results/E6_smoke/
results/E6_smoke/raw/
results/E6*/**/*.npz
results/E6*/*.npz
# Petri .eval transcripts and the harvested replay battery: audit transcripts of
# committed-user scenarios, regenerable by re-running the auditor. The harvester's
# manifest (counts, seeds, model ids, shas) is the committed evidence.
experiments/e6_petri/output/*
!experiments/e6_petri/output/manifest.json
